{
  "enabled": true,
  "name": "Code Quality Review",
  "description": "Analyzes modified source code for potential improvements including code smells, design patterns, and best practices. Generates suggestions for improving readability, maintainability, and performance while preserving functionality.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.py",
      "tests/**/*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Analyze the modified code for potential improvements. Review for:\n\n1. **Code Smells**: Long methods, duplicate code, dead code, overly complex conditionals, magic numbers/strings\n2. **Design Patterns**: Opportunities to apply appropriate patterns, anti-patterns to avoid\n3. **Best Practices**: Pythonic idioms, proper error handling, type hints, docstrings\n4. **Readability**: Clear naming, logical structure, appropriate comments\n5. **Maintainability**: Single responsibility, loose coupling, proper abstractions\n6. **Performance**: Inefficient algorithms, unnecessary operations, memory concerns\n\nProvide specific, actionable suggestions that maintain existing functionality. Prioritize the most impactful improvements."
  },
  "workspaceFolderName": "postgres-mcp-pro-plus",
  "shortName": "code-quality-review"
}